generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // On Railway's own Postgres plugin (no separate pooler in front of it),
  // set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ── NextAuth required tables ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Users (admin/staff login — extends NextAuth User with role) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("viewer")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  publishLogs PublishLog[]
}

// ── Members (paying subscribers — gated by Systeme.io tag, ────────
// ── NOT admin/staff login; see open question in commit message) ───

model Member {
  id                   String    @id @default(cuid())
  email                String    @unique
  firstName            String?
  lastName             String?
  password             String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  systemeTag           String?
  // Doubles as the manual admin disable switch ("disabled") and, in the
  // future, the target of a Systeme.io tag-driven webhook (active/
  // cancelled) that doesn't exist yet. Reusing one field is a known,
  // deliberate tradeoff -- when that webhook is built, it needs a
  // precedence rule against a manual disable (or a split into a separate
  // field) so the two writers can't silently undo each other.
  status               String    @default("active")
  expiresAt            DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// ── Core content tables ───────────────────────────────────────────

model Event {
  id                     String    @id @default(cuid())
  slug                   String?   @unique
  eventDate              DateTime
  hostName               String?
  hostTitle              String?   @default("Affiliate Management Expert")
  hostHeadshotUrl        String?
  hostPhotoUrl           String?
  recordingUrl           String?
  giftPublicUntil        DateTime?
  hostNote               String?   @db.Text
  hostBio                String?   @db.Text
  heroSubheading         String?   @db.Text
  registrationHeading    String?
  registrationSubheading String?   @db.Text
  surveyUrl              String?
  transcriptRaw          String?   @db.Text
  transcriptCleaned      String?   @db.Text
  youtubeId              String?
  titleOriginal          String
  titleYoutube           String?
  titlePodcast           String?
  descriptionOriginal    String?   @db.Text
  descriptionYoutube     String?   @db.Text
  descriptionWebsite     String?   @db.Text
  tags                   String[]
  thumbnailUrl           String?
  coverArtUrl            String?
  youtubeThumbnailUrl    String?
  audioUrl               String?
  videoUrl               String?
  mp4Url                 String?
  durationSeconds        Int?
  publishStatus          String    @default("draft")
  publishedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  panelists          Panelist[]
  leads              Lead[]
  publishLogs        PublishLog[]
  transcriptSegments TranscriptSegment[]
  registrations      Registration[]

  @@index([publishStatus])
  @@index([eventDate])
}

// ── In-app event registration (replaces the Systeme.io funnel) ────
// The outbound Systeme.io sync is a separately planned task; emailSynced
// marks rows that task should pick up, matching the same convention
// already used on Lead.emailSynced.

model Registration {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  email       String
  emailSynced Boolean  @default(false)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([email])
}

model Panelist {
  id                   String   @id @default(cuid())
  eventId              String
  name                 String
  titleByline          String?
  titleAreaOfExpertise String?
  bio                  String?  @db.Text
  shortBio             String?  @db.Text
  headshotUrl          String?
  email                String?
  affiliateLink        String?
  swipeCopy            String?  @db.Text
  transcriptSegment    String?  @db.Text
  guideBio             String?  @db.Text
  guideFrameworks      String?  @db.Text
  guideTakeaways       String?  @db.Text
  guideQuotes          String?  @db.Text
  guideActionItems     String?  @db.Text
  guidePdfUrl          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event              Event               @relation(fields: [eventId], references: [id])
  toolEntry          ToolEntry?
  aiLogs             AiContentLog[]
  transcriptSegments TranscriptSegment[]

  @@index([eventId])
}

model ToolEntry {
  id                  String   @id @default(cuid())
  panelistId          String   @unique
  freeGiftTitle       String?
  freeGiftDescription String?  @db.Text
  freeGiftUrl         String?
  vipGiftTitle        String?
  vipGiftDescription  String?  @db.Text
  vipGiftUrl          String?
  featured            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  panelist Panelist @relation(fields: [panelistId], references: [id])
}

// ── Transcript attribution (Phase 1 Section 3) ────────────────────
// Parsed VTT segments awaiting/having gone through the Admin Review
// Screen. Only status = "approved" segments feed into
// Panelist.transcriptSegment (and from there, AI guide generation).

model TranscriptSegment {
  id                String   @id @default(cuid())
  eventId           String
  order             Int
  rawSpeakerLabel   String
  text              String   @db.Text
  matchedPanelistId String?
  confidenceScore   Float?
  isHostExcluded    Boolean  @default(false)
  status            String   @default("pending") // pending | approved | rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event           Event     @relation(fields: [eventId], references: [id])
  matchedPanelist Panelist? @relation(fields: [matchedPanelistId], references: [id])

  @@index([eventId])
  @@index([matchedPanelistId])
}

model Cta {
  id              String   @id @default(cuid())
  crisisCategory  String   @unique
  headline        String
  subtext         String?
  buttonLabel     String
  assessmentEntry Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ── Assessment + lead funnel tables (dormant — reserved for ───────
// ── Phase 3 Affiliate Tracking, not wired up in Phase 1) ──────────

model Lead {
  id               String   @id @default(cuid())
  email            String
  firstName        String?
  crisisCategory   String
  crisisDuration   String?
  urgency          String?
  score            Int?
  resultType       String?
  sourceEventId    String?
  affiliateRouteId String?
  expertReferralId String?
  emailSynced      Boolean  @default(false)
  ipAddress        String?
  createdAt        DateTime @default(now())

  sourceEvent    Event?          @relation(fields: [sourceEventId], references: [id])
  affiliateRoute AffiliateRoute? @relation(fields: [affiliateRouteId], references: [id])
  expertReferral ExpertReferral? @relation(fields: [expertReferralId], references: [id])

  @@index([email])
  @@index([crisisCategory])
  @@index([urgency])
}

model AffiliateRoute {
  id             String   @id @default(cuid())
  crisisCategory String
  urgencyLevel   String
  affiliateName  String
  affiliateUrl   String   @db.Text
  priority       Int      @default(1)
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  leads Lead[]
}

model ExpertReferral {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  bio              String?  @db.Text
  specialties      String[]
  urgencyLevels    String[]
  profileUrl       String?
  photoUrl         String?
  referralFeeType  String?
  referralFeeValue Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  leads Lead[]
}

// ── Operations tables ─────────────────────────────────────────────

model PublishLog {
  id             String   @id @default(cuid())
  eventId        String
  triggeredById  String?
  platform       String
  status         String   @default("pending")
  webhookPayload Json?
  responseBody   Json?
  createdAt      DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id])
  triggeredBy User? @relation(fields: [triggeredById], references: [id])
}

model SiteConfig {
  id        String   @id @default(cuid())
  config    Json
  updatedAt DateTime @updatedAt
}

model AssessmentConfig {
  id        String   @id @default(cuid())
  config    Json
  updatedAt DateTime @updatedAt
}

model AiContentLog {
  id          String   @id @default(cuid())
  panelistId  String?
  provider    String
  contentType String
  prompt      String   @db.Text
  output      String   @db.Text
  tokensUsed  Int?
  approved    Boolean?
  createdAt   DateTime @default(now())

  panelist Panelist? @relation(fields: [panelistId], references: [id])
}
