# ── Database (required) ───────────────────────────────────────────
# Pooled connection string, used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string, used by Prisma for migrations/
# introspection. On Railway's own Postgres plugin (no separate pooler),
# set this to the same value as DATABASE_URL. Only differs from
# DATABASE_URL when the pooled connection goes through something like
# Supabase's pgbouncer (port 6543) or PgBouncer added separately.
DIRECT_URL=

# ── Auth (required) ────────────────────────────────────────────────
# Random secret used to sign NextAuth session JWTs. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# The full public URL this deployment is served at (protocol + host,
# no trailing slash) — must match exactly or auth callbacks break.
NEXTAUTH_URL=

# ── Admin seed (required) ──────────────────────────────────────────
# Password for the seeded super_admin account (see prisma/seed.ts).
ADMIN_PASSWORD=

# ── Cloudflare R2 file storage (Section 7) ─────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Defaults to "big-impact-experts-media" in code if unset.
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# ── Claude API (AI content generation) ─────────────────────────────
CLAUDE_API_KEY=

# ── Systeme.io (Section 8 — one-directional webhook only) ──────────
SYSTEME_API_KEY=

# ── Publish webhook ─────────────────────────────────────────────────
MAKE_WEBHOOK_URL=

# ── Public Event Page (Section 6) ───────────────────────────────────
# Where /events/[eventId] redirects to once Event.giftPublicUntil has
# passed. Defaults to "/" (homepage) in code if unset -- set this once
# the real Membership Offer Sales Page exists.
MEMBERSHIP_SALES_PAGE_URL=
